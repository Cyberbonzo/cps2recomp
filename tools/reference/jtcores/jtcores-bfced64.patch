+#endif
+    fclose(f);
+    fprintf(stderr, "\nState saved at frame %d (%s)\n", frame_cnt, prefix);
+}
+void JTSim::load_state(const char *prefix) {
+    string vlt = string(prefix) + ".vlt", har = string(prefix) + ".harness";
+    {
+        VerilatedRestore os;
+        os.open(vlt.c_str());
+        os >> game.contextp();
+        os >> game;
+    }
+    FILE *f = fopen(har.c_str(), "rb");
+    if( !f ) throw "state: cannot read";
+    hget(f, simtime); hget(f, frame_cnt); hget(f, last_VS); hget(f, last_LVBL); hget(f, last_flip);
+    hget(f, last_frame_time); hget(f, multi_clock->count()); hget(f, download); hget(f, release_reset_pending);
+    hget(f, release_reset_wait); hget(f, cpu_clk);
+    sdram.load(f);
+#ifdef _JTFRAME_SDRAM_XL
+    sdram2.load(f);
+#endif
+    fclose(f);
+    fprintf(stderr, "State loaded: frame %d (%s)\n", frame_cnt, prefix);
 }
 
